<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.HymnBook" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/warm_light_blue_1</item><!--toggle button-->
        <item name="colorPrimaryContainer">@color/warm_light_blue_2</item><!--toggle button background-->
        <item name="colorPrimaryDark">@color/transparent_grey_black</item><!--appbar-->
        <item name="colorAccent">@color/black</item><!--header text-->
        <item name="android:textColor">@color/black</item>
        <item name="fullscreenBackgroundColor">@color/white</item>
        <item name="fullscreenTextColor">@color/black</item>
    </style>

    <style name="Theme.HymnBook" parent="Base.Theme.HymnBook"/>

    <!-- Base application theme for Dark Mode -->
    <style name="AppTheme.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimaryDark</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDarkDark</item>
        <item name="colorAccent">@color/colorAccentDark</item>
        <!-- Other attributes for dark mode -->
    </style>

    <style name="ThemeOverlay.HymnBook.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/light_blue_600</item>
        <item name="fullscreenTextColor">@color/light_blue_A200</item>
    </style>

</resources>